# POSTGRES_USER is the local PostgreSQL user for docker compose.
POSTGRES_USER=app

# POSTGRES_PASSWORD is the local PostgreSQL password for docker compose.
POSTGRES_PASSWORD=app_secret

# POSTGRES_DB is the local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# BACKEND_PORT is the host port mapped to backend port 8080.
BACKEND_PORT=8080

# FRONTEND_PORT is the host port mapped to frontend port 3000.
FRONTEND_PORT=3000

# NEXT_PUBLIC_API_URL is the browser-visible backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
