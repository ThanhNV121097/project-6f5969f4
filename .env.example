# Local PostgreSQL user for docker compose.
POSTGRES_USER=hello

# Local PostgreSQL password for docker compose; replace outside git.
POSTGRES_PASSWORD=hello

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=hello_word

# Backend PostgreSQL connection string used outside compose.
DATABASE_URL=postgres://hello:hello@db:5432/hello_word?sslmode=disable

# Backend HTTP listen port.
PORT=8080

# Browser-visible backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
